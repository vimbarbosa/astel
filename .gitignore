bin/
obj/
out/
Debug/
Release/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/

# Rider
.idea/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
*.snupkg
*.nuspec
packages/
*.nuget.props
*.nuget.targets

# DotCover
*.dotCover

# Logs
*.log

# Visual Studio cache/options directory
.vs/
